{
  "generators": [
    {
      "name": "traces",
      "topic": "agent.traces",
      "fork": {
        "key": {
          "_gen": "uuid"
        },
        "maxForks": 10,
        "stagger": 200
      },
      "key": {
        "traceId": {
          "_gen": "var",
          "var": "forkKey"
        }
      },
      "value": {
        "traceId": {
          "_gen": "var",
          "var": "forkKey"
        },
        "spanId": {
          "_gen": "uuid"
        },
        "service": "agent-orchestrator",
        "environment": "staging",
        "startedAt": {
          "_gen": "formatDateTime",
          "ms": {
            "_gen": "now"
          }
        }
      },
      "stateMachine": {
        "_gen": "stateMachine",
        "initial": "root",
        "transitions": {
          "root": "llm",
          "llm": "tools",
          "tools": "finalize"
        },
        "states": {
          "root": {
            "value": {
              "spanName": "POST /v1/agent/run",
              "spanKind": "SERVER",
              "parentSpanId": null,
              "statusCode": 200
            }
          },
          "llm": {
            "value": {
              "spanName": "llm.chat.completions",
              "spanKind": "CLIENT",
              "parentSpanId": {
                "_gen": "previousEvent",
                "path": [
                  "value",
                  "spanId"
                ]
              },
              "model": {
                "_gen": "weightedOneOf",
                "choices": [
                  {
                    "weight": 7,
                    "value": "gpt-4.1-mini"
                  },
                  {
                    "weight": 3,
                    "value": "claude-sonnet-5"
                  }
                ]
              },
              "promptTokens": {
                "_gen": "uniformDistribution",
                "bounds": [
                  200,
                  4000
                ],
                "decimals": 0
              },
              "completionTokens": {
                "_gen": "uniformDistribution",
                "bounds": [
                  20,
                  1200
                ],
                "decimals": 0
              },
              "statusCode": 200
            }
          },
          "tools": {
            "value": {
              "spanName": "tool.vector_search",
              "spanKind": "CLIENT",
              "parentSpanId": {
                "_gen": "previousEvent",
                "path": [
                  "value",
                  "spanId"
                ]
              },
              "statusCode": {
                "_gen": "weightedOneOf",
                "choices": [
                  {
                    "weight": 95,
                    "value": 200
                  },
                  {
                    "weight": 5,
                    "value": 500
                  }
                ]
              }
            }
          },
          "finalize": {
            "value": {
              "spanName": "response.serialize",
              "spanKind": "INTERNAL",
              "parentSpanId": {
                "_gen": "previousEvent",
                "path": [
                  "value",
                  "spanId"
                ]
              },
              "statusCode": 200
            }
          }
        }
      },
      "localConfigs": {
        "throttleMs": 2000
      }
    },
    {
      "name": "metrics",
      "topic": "agent.metrics",
      "value": {
        "metricId": {
          "_gen": "uuid"
        },
        "service": "agent-orchestrator",
        "windowStart": {
          "_gen": "formatDateTime",
          "ms": {
            "_gen": "now"
          }
        },
        "cpuPercent": {
          "_gen": "normalDistribution",
          "mean": 45,
          "sd": 12,
          "clamp": [
            0,
            100
          ],
          "decimals": 1
        },
        "memoryMb": {
          "_gen": "normalDistribution",
          "mean": 1800,
          "sd": 250,
          "clamp": [
            200,
            8192
          ],
          "decimals": 0
        },
        "requestsPerMin": {
          "_gen": "uniformDistribution",
          "bounds": [
            40,
            600
          ],
          "decimals": 0
        },
        "p95LatencyMs": {
          "_gen": "normalDistribution",
          "mean": 1200,
          "sd": 400,
          "clamp": [
            50,
            9000
          ],
          "decimals": 0
        },
        "errorRate": {
          "_gen": "weightedOneOf",
          "choices": [
            {
              "weight": 90,
              "value": 0.0
            },
            {
              "weight": 8,
              "value": 0.01
            },
            {
              "weight": 2,
              "value": 0.05
            }
          ]
        }
      },
      "localConfigs": {
        "throttleMs": 5000
      }
    },
    {
      "name": "logs",
      "topic": "agent.logs",
      "vars": {
        "trace": {
          "_gen": "lookup",
          "name": "traces"
        }
      },
      "value": {
        "logId": {
          "_gen": "uuid"
        },
        "traceId": {
          "_gen": "var",
          "var": "trace",
          "path": [
            "value",
            "traceId"
          ]
        },
        "level": {
          "_gen": "weightedOneOf",
          "choices": [
            {
              "weight": 80,
              "value": "INFO"
            },
            {
              "weight": 15,
              "value": "WARN"
            },
            {
              "weight": 5,
              "value": "ERROR"
            }
          ]
        },
        "message": {
          "_gen": "oneOf",
          "choices": [
            {
              "_gen": "string",
              "expr": "tool call completed in #{Number.numberBetween '50','900'}ms"
            },
            {
              "_gen": "string",
              "expr": "rate limit headroom low: #{Number.numberBetween '1','20'} requests"
            },
            {
              "_gen": "string",
              "expr": "vector index refresh finished: #{Number.numberBetween '10','500'} documents"
            },
            {
              "_gen": "string",
              "expr": "model fallback triggered after #{Number.numberBetween '1','3'} retries"
            }
          ]
        },
        "loggedAt": {
          "_gen": "formatDateTime",
          "ms": {
            "_gen": "now"
          }
        }
      },
      "localConfigs": {
        "throttleMs": 1500
      }
    }
  ],
  "connections": {
    "kafka": {
      "kind": "kafka",
      "producerConfigs": {
        "bootstrap.servers": "localhost:9092",
        "key.serializer": "io.shadowtraffic.kafka.serdes.JsonSerializer",
        "value.serializer": "io.shadowtraffic.kafka.serdes.JsonSerializer"
      }
    }
  }
}
